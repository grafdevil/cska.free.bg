/* =====================================================
   СКРИВАНЕ НА LOADER-А СЛЕД ЗАРЕЖДАНЕ НА СТРАНИЦАТА
   ===================================================== */

// Изчакваме браузърът да зареди напълно HTML структурата (DOM)
document.addEventListener('DOMContentLoaded', () => {

  // Намираме елемента на лоудъра по неговото ID
  const loader = document.getElementById('loader');
  
  // Проверка за сигурност: ако лоудърът не съществува в HTML, спираме функцията
  if (!loader) return;

  // Задаваме кратко закъснение от 500 милисекунди (0.5 сек)
  // Това гарантира, че потребителят ще види анимацията и няма да има рязко "премигване"
  setTimeout(() => {

    /* --- Fade-out анимация (Плавно изчезване) --- */
    
    // Динамично добавяме CSS преход за прозрачността (трае 0.5 секунди)
    loader.style.transition = 'opacity 0.5s ease';
    
    // Правим лоудъра напълно прозрачен
    loader.style.opacity = '0';

    /* --- Пълно премахване след края на анимацията --- */
    
    // Изчакваме точно толкова време, колкото трае анимацията (500ms)
    setTimeout(() => {
      // Скриваме елемента напълно от екрана, за да не пречи на кликането по сайта
      loader.style.display = 'none';
    }, 500);

  }, 500); // ⏱️ Първоначалното изчакване преди старта на скриването

});
