// =====================================================
// menu.js
// =====================================================

// Глобален обект, който ще съхранява данните за всички страници, след като се заредят
let pages = {};

/* =====================================================
   Зареждане на pages.json
   ===================================================== */

// Използваме функцията fetch, за да направим мрежова заявка към JSON файла в папка 'json/'
fetch("json/pages.json")
  
  // Първи етап: Когато сървърът отговори, превръщаме суровия текст (JSON) в четим JavaScript обект
  .then(res => res.json())
  
  // Втори етап: Работа с получените данни (data)
  .then(data => {
    // Присвояваме получените данни на нашата глобална променлива 'pages'
    pages = data;
    
    // Извикваме функцията, която физически ще създаде бутоните в менюто (createMenu)
    // Тази функция трябва да е дефинирана по-надолу в кода ти
    createMenu();
  })
  
  // Трети етап: Обработка на евентуални грешки
  .catch(err =>
    // Ако файлът липсва или има грешка в синтаксиса му, изписваме съобщение в конзолата
    console.error("Грешка при зареждане на базата с данни:", err)
  );
/* =====================================================
   Създаване на popup меню
   ===================================================== */
function createMenu() {
  // Намира контейнера, в който ще се поставят бутоните на менюто
  const menuContainer = document.getElementById("popup-menu-container");
  
  // Ако елементът не съществува в HTML-а, спира изпълнението на функцията
  if (!menuContainer) return;

  // Изчиства съдържанието на контейнера (премахва старите бутони)
  menuContainer.innerHTML = "";

  // Обхожда всеки ключ (страница) от заредения обект 'pages'
  Object.keys(pages).forEach(key => {
    // Създава нов елемент от тип линк (<a>)
    const link = document.createElement("a");
    
    // Задава текста на бутона според заглавието в JSON файла
    link.textContent = pages[key].title;
    
    // Задава празен линк, за да не презарежда страницата
    link.href = "#";
    
    // Добавя специфичен атрибут (data-popup), който съхранява ключа на страницата
    link.dataset.popup = key;

    // Добавя слушател за клик върху всеки бутон
    link.addEventListener("click", e => {
      e.preventDefault(); // Спира стандартното действие на линка (прескачане)
      showPopup(key);     // Извиква функцията за показване на изскачащия прозорец с данни
    });

    // Добавя готовия бутон в менюто
    menuContainer.appendChild(link);
  });
}

// Изпълнява се, когато целият HTML е зареден в браузъра
document.addEventListener("DOMContentLoaded", () => {
  const toggle = document.getElementById("menu-toggle"); // Бутонът "бургер" (☰)
  const menu = document.getElementById("popup-menu-container"); // Самото меню

  // Проверка за сигурност дали елементите съществуват
  if (!toggle || !menu) return;

  // Слушател за клик върху бутона за мобилно меню
  toggle.addEventListener("click", () => {
    menu.classList.toggle("show"); // Добавя или премахва класа 'show' (отваря/затваря)
  });

  // Автоматично затваря мобилното меню, след като се избере категория от него
  menu.addEventListener("click", e => {
    if (e.target.tagName === "A") { // Проверява дали е кликнато върху линк
      menu.classList.remove("show"); // Скрива менюто
    }
  });
});

// Слушател за клик върху целия документ (за затваряне при клик извън менюто)
document.addEventListener("click", e => {
  const menu = document.getElementById("popup-menu-container");
  const toggle = document.getElementById("menu-toggle");

  if (!menu || !toggle) return;

  // Ако менюто в момента е скрито, не прави нищо
  if (!menu.classList.contains("show")) return;

  // Ако кликът е върху самия бутон ☰, не прави нищо (той има собствен слушател)
  if (toggle.contains(e.target)) return;

  // Ако кликът е вътре в самото меню, не го затваряй
  if (menu.contains(e.target)) return;

  // ВЪВ ВСИЧКИ ОСТАНАЛИ СЛУЧАИ (клик извън менюто) -> затвори го
  menu.classList.remove("show");
});


/* =====================================================
   Показване на popup съдържание
   ===================================================== */
function showPopup(pageKey) {
  const overlay = document.getElementById("popup-overlay"); // Взема черния фон
  const content = document.getElementById("popup-content"); // Взема кутията за текст
  const page = pages[pageKey]; // Взема данните за конкретната страница от обекта pages

  if (!page || !overlay || !content) return; // Проверка за грешки

  overlay.style.display = "flex"; // Показва черния фон (overlay)
  overlay.classList.add("show");  // Активира анимацията за поява
  content.innerHTML = "Зареждане..."; // Временно съобщение, докато се теглят данните

  // Специален случай за секция "История" (ако данните не са във външен файл)
  if (pageKey === "history") {
    renderHistory(content); // Извиква специфична функция за история
    return; // Спира дотук, за да не прави излишни заявки (fetch)
  }

  // Ако страницата изисква данни от външен файл (JSON)
  if (page.source) {
    fetch(page.source) // Тегли файла (напр. players.json)
      .then(res => res.json())
      .then(data => renderPopupContent(pageKey, data, content)) // Изпраща данните за "рисуване"
      .catch(() => content.innerHTML = "Грешка при зареждане"); // При проблем с интернет/файл
  } else {
    // Ако страницата няма външен файл, показва статичния текст от pages.json
    content.innerHTML = page.content || "Няма съдържание";
  }
}

/* =====================================================
   Рендериране (рисуване) на съдържанието в Popup-а
   ===================================================== */
function renderPopupContent(pageKey, data, content) {

  /* -------- Секция: ИГРАЧИ -------- */
  if (pageKey === "players" && data.players) {
    // Генерира списък с всички играчи, подредени в редове със снимка и инфо
    content.innerHTML = data.players.map(p => `
      <div class="player-row">
        <img src="${p.photo || 'no-photo.png'}"> <!-- Снимка или резервна картинка -->
        <div>
          <h1 style="opacity:0.5;">№${p.number}</h1> <!-- Голям прозрачен номер -->
          <h2>${p.name}</h2> <!-- Име на играча -->
          Години: ${p.age}<br>
          Позиция: ${p.position}<br>
          Националност: ${p.nation}
        </div>
      </div>
    `).join(""); // Обединява всички генерирани редове в един общ текст
    return;
  }

  /* -------- Секция: МАЧОВЕ -------- */
  if (pageKey === "matches" && data.matches) {
    const now = new Date(); // Взима текущата дата и час за сравнение

    // Филтрира мачовете, чиято дата е по-голяма от текущата (Предстоящи)
    const futureMatches = data.matches
      .filter(m => new Date(m.datetime) > now)
      .sort((a, b) => new Date(a.datetime) - new Date(b.datetime)); // Най-близкият е пръв

    // Филтрира мачовете, чиято дата е минала (Изминали)
    const pastMatches = data.matches
      .filter(m => new Date(m.datetime) <= now)
      .sort((a, b) => new Date(b.datetime) - new Date(a.datetime)); // Последният изигран е пръв

    // Генерира финалния HTML с двете подсекции
    content.innerHTML = `
      <h2 style="margin-top:20px;text-align:center;">Предстоящи мачове</h2>
      <hr>

      <!-- Информационни съобщения в стил цитат -->
      <blockquote class="custom">
        За момента изчаквам клуба да публикува точните дати и часове на контролите.
      </blockquote>
      <blockquote class="custom">
        Срещите от първенство и купа са с примерен час до официално потвърждение.
      </blockquote>

      <!-- Показва списъка с бъдещи мачове -->
      ${futureMatches.map(m => matchHtml(m, data)).join("")}

      <h2 style="margin-top:20px;text-align:center;">Изминали мачове</h2>
      <hr>

      <!-- Показва списъка с изминали мачове -->
      ${pastMatches.map(m => matchHtml(m, data)).join("")}
    `;
    return;
  }

  /* -------- СТАТИЧНИ СТРАНИЦИ -------- */
  // Ако данните съдържат просто текст, го показва
  if (data.content) {
    content.innerHTML = data.content;
  } else {
    content.innerHTML = "Няма съдържание";
  }
}
/* =====================================================
   ЗАТВАРЯНЕ НА POPUP (ИЗСКАЧАЩ ПРОЗОРЕЦ)
   ===================================================== */
const overlay = document.getElementById("popup-overlay"); // Взема черния фон
const btnClose = document.getElementById("popup-close");  // Взема бутона "X"

// Проверка дали бутонът и фонът съществуват, за да се избегнат грешки
if (btnClose && overlay) {
  // При клик върху "X":
  btnClose.addEventListener("click", () => {
    overlay.style.display = "none";      // Скрива елемента веднага
    overlay.classList.remove("show");    // Премахва анимационния клас
  });
}

// Затваряне при клик върху черния фон (извън прозореца)
if (overlay) {
  overlay.addEventListener("click", e => {
    // Проверява дали е кликнат точно фонът, а не съдържанието вътре в него
    if (e.target.id === "popup-overlay") {
      overlay.style.display = "none";
    }
  });
}

/* =====================================================
   ПОМОЩНИ ФУНКЦИИ ЗА МАЧОВЕ
   ===================================================== */

// Функция за превръщане на системна дата в красив български формат
function formatDate(dateString) {
  const d = new Date(dateString); // Превръща стринга в обект Дата
  return d.toLocaleDateString("bg-BG", { // Форматира за България:
    year: "numeric",   // Година (2025)
    month: "2-digit",  // Месец (12)
    day: "2-digit",    // Ден (27)
    hour: "2-digit",   // Час (21)
    minute: "2-digit"  // Минути (00)
  });
}

// Главна функция за генериране на HTML структурата на всеки мач
function matchHtml(m, data) {
  // Намира пълните данни за домакина в масива с клубове по неговото ID
  const home = data.clubs.find(c => c.id === m.home);
  // Намира пълните данни за госта в масива с клубове по неговото ID
  const away = data.clubs.find(c => c.id === m.away);

  // Връща готов HTML код за реда с мача
  return `
    <div class="match-row">

      <!-- Показва форматираната дата отгоре -->
      <b style="display:block;margin-bottom:10px;">
        ${formatDate(m.datetime)}
      </b>

      <!-- Контейнер за логата и надписа VS -->
      <div style="display:flex;justify-content:space-around;align-items:center;margin-bottom:10px;">

        <!-- Домакин: лого + име -->
        <div>
          <img src="${home?.logo || ''}">
          <div style="margin-top:6px;font-weight:600;">${home?.name || m.home}</div>
        </div>

        <!-- Разделител VS -->
        <div style="font-size:22px;font-weight:700;color:#ffcc00;">VS</div>

        <!-- Гост: лого + име -->
        <div>
          <img src="${away?.logo || ''}">
          <div style="margin-top:6px;font-weight:600;">${away?.name || m.away}</div>
        </div>

      </div>

      <!-- Резултат: показва се само ако мачът е завършил (има записан резултат) -->
      ${m.result ? `<div style="font-size:20px;color:#2ba630;font-weight:700;">${m.result}</div>` : ""}
      
      <!-- Турнир (напр. Първенство) -->
      <div style="color:#ff4444;margin-top:5px;">(${m.tournament})</div>

      <!-- Кръг или Фаза: показва се само ако са дефинирани в данните -->
      ${
        m.round
          ? `<div style="margin-bottom:8px;font-size:16px;font-weight:600;color:#ff4444;">
              ${
                // Променя думата според типа турнир
                m.tournament === 'Първенство'
                  ? 'Кръг'
                  : m.tournament === 'Купа на България'
                    ? 'Фаза'
                    : ''
              }: ${m.round}
            </div>`
          : ""
      }
    </div>
  `;
}
